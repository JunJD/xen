{
  "name": "@xen/extension",
  "description": "沉浸式网页翻译与语法/词汇高亮，支持双模式、忽略名单与 LLM 模型。",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:pyodide": "node ./scripts/sync-pyodide.mjs",
    "predev": "pnpm run sync:pyodide",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "prebuild": "pnpm run sync:pyodide",
    "build": "wxt build",
    "prebuild:firefox": "pnpm run sync:pyodide",
    "build:firefox": "wxt build -b firefox",
    "prezip": "pnpm run sync:pyodide",
    "zip": "wxt zip",
    "prezip:firefox": "pnpm run sync:pyodide",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "pnpm run sync:pyodide && wxt prepare"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@base-ui/react": "^1.2.0",
    "@clerk/chrome-extension": "^2.9.8",
    "@mozilla/readability": "^0.6.0",
    "@tabler/icons-react": "^3.36.1",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@webext-core/messaging": "^2.3.0",
    "@xen/contracts": "workspace:*",
    "ai": "^5.0.137",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.3.0",
    "franc": "^6.2.0",
    "js-sha256": "^0.11.1",
    "lucide-react": "^0.563.0",
    "motion": "^12.34.0",
    "pyodide": "^0.21.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tippy.js": "^6.3.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4",
    "wxt": "^0.20.15"
  }
}
